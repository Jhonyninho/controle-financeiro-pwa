# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase > Project Settings > API).
#
# Use SOMENTE a chave pública ("publishable" / "anon"). Ela pode ficar no
# navegador porque o acesso aos dados é protegido pelo RLS do banco.
# NUNCA coloque a chave "secret" / "service_role" aqui nem em nenhum arquivo do app.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Caminho onde o app é publicado (GitHub Pages: /nome-do-repositorio/)
VITE_BASE_PATH=/

# Open Finance: "1" mostra os bancos de teste (sandbox) da Pluggy no widget.
# As credenciais da Pluggy NUNCA ficam aqui: só nos secrets das Edge Functions.
VITE_PLUGGY_SANDBOX=1
